<h6>
  Scores
</h6>
 <div class='table-responsive'>
  <table class='table table-hover table-sm'>
    <thead class='thead-light'>
      <tr>
        <th>
          Panelist
        </th>
        <th class='d-none d-sm-table-cell'>
          Category
        </th>
        <th class='d-none d-sm-table-cell'>
          Kind
        </th>
        <th class='d-none d-sm-table-cell text-center'>
          Num
        </th>
        <th class='text-right'>
          Points
        </th>
      </tr>
    </thead>
    <tbody>
      {{#each this.sortedPanelists as |panelist|}}
        <tr class={{panelist.rowClass}}>
          <td class='align-middle panelest-scoretext'>
            {{panelist.name}}
            <div class='d-sm-none panelist-mobile-details'>
              {{panelist.category}} &middot; {{panelist.kind}} &middot; #{{panelist.num}}
            </div>
          </td>
          <td class='align-middle panelest-scoretext d-none d-sm-table-cell'>{{panelist.category}}</td>
          <td class='align-middle panelest-scoretext d-none d-sm-table-cell'>{{panelist.kind}}</td>
          <td class='align-middle panelest-scoretext text-center d-none d-sm-table-cell'>{{panelist.num}}</td>
          <td class='max-score'>{{panelist-scores model=panelist appearance=this.model onScoreChange=this.onScoreChange setDisableCheckAppearance=this.setDisableCheckAppearance}}</td>
        </tr>
      {{else}}
        <tr>
          (No panelists)
        </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr>
        {{!-- <td colspan=4 class='text-right'>{{this.model.sumSongs}}</td> --}}
      </tr>
    </tfoot>
  </table>
</div>